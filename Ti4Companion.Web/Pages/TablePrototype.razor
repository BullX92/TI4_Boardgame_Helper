@page "/table"
@page "/table/{Code}"
@layout EmptyLayout
@inherits Ti4ComponentBase
@inject NavigationManager Nav
<PageTitle>TI4 · Table Companion</PageTitle>
<main lang="en" class="table-app @(Store.Me?.Id==Store.Session?.ActivePlayerId&&Store.Session?.Phase==GamePhase.Action?"is-my-turn":"")" style="--seat:@(Store.Me?.ColorHex??"#4a90d9")">
    <header class="table-top"><a href="/prototype.html" target="_top"><img src="/assets/ti4-agent/favicon.svg" width="28" height="28" alt="" /><span class="table-brand">TI4-Agent<small>TABLE COMPANION</small></span></a><span class="table-live">@(Store.Connected?"● Live":HasCode?"○ Connecting":"NEW SESSION")</span></header>
    @if(error is not null){<p role="alert" class="table-error">@error</p>}
    @if(!loaded){<p>Loading your session …</p>}
    else if(!HasCode||Store.Session is not {} s){<PrototypeCreateSession Device="Device" />}
    else if(Store.Me is null||ChooseIdentity){
        <section class="table-panel identity-picker"><p class="table-kicker">SESSION @s.JoinCode</p><h1>Which player are you?</h1><p>Choose your name, then select your faction.</p>
        @if(Store.IsHost){<details open><summary>Invitation link ready</summary><div class="claim-invite"><JoinQr Text="@InviteUrl" SizeCss="6rem" Alt="Scan to join this session" /><a href="@InviteUrl">@InviteUrl</a></div></details>}
        @foreach(var p in s.Players.OrderBy(p=>p.SeatOrder)){<button class="seat-choice" disabled="@(busy||(p.SeatClaimed&&p.Id!=Store.MyPlayerId))" @onclick="()=>Claim(p.Id)"><strong>@p.Name</strong><span>@(p.SeatClaimed&&p.Id!=Store.MyPlayerId?"Connected":p.Id==Store.MyPlayerId?"Creator · select your seat":"Choose seat →")</span></button>}
        </section>
    }
    else{
        var me=Store.Me;var mine=me.Id==s.ActivePlayerId;var active=Store.PlayerById(s.ActivePlayerId);
        var order=s.Players.OrderBy(p=>p.Initiative??99).ThenBy(p=>p.SeatOrder).ToList();var secondary=SecondaryPlayer(s);
        <div class="table-meta"><span>ROUND @s.CurrentRound</span><span>@Phase(s.Phase)</span><span>@s.JoinCode</span></div>
        <section class="table-identity"><div class="table-portrait"><PrototypeFactionArt FactionId="@me.FactionId" Name="@(Store.Faction(me.FactionId)?.Name??"Choose your faction")" /></div><div><h1>@me.Name</h1><p>@(Store.Faction(me.FactionId)?.Name??"Choose your faction")</p></div><span class="table-initiative">@(me.Initiative?.ToString()??"—")<small>INITIATIVE</small></span></section>
        @if(s.Phase==GamePhase.Setup){<PrototypeTableSetup />}
        else if(s.Phase is GamePhase.Strategy or GamePhase.Action){
            <div class="play-grid"><div class="turn-main">
            @if(s.Phase==GamePhase.Strategy){
                var picker=Store.PlayerById(Store.CurrentPickerId);var count=GameRules.StrategyCardsPerPlayer(s.Players.Count,s.StrategyCardsPerPlayer);
                <section class="table-panel pick-console"><p class="table-kicker">STRATEGY DRAFT · @count EACH</p><h2>@(picker?.Id==me.Id?"Your pick":picker is null?"Ready to start":$"{picker.Name} picks")</h2>
                <p class="pick-progress">Your cards: @me.StrategyCards.Count / @count</p>
                @if(picker?.Id==me.Id){<div class="table-card-grid">@foreach(var c in Store.Content?.StrategyCards??[]){<button disabled="@(busy||s.Players.Any(p=>p.StrategyCards.Any(x=>x.StrategyCardId==c.Id)))" @onclick="()=>Pick(me.Id,c.Id)"><b>@c.Initiative</b>@c.Name</button>}</div>}
                else if(picker is not null){<p>Clockwise from the Speaker.</p>}
                @if(Store.IsHost){<button class="table-primary" disabled="@(busy||!Store.StrategyPickDone)" @onclick="ActionPhase">Start game →</button>}
                </section>
            }
            else{
                <section class="table-focus @(mine?"is-active":"")"><p class="table-kicker">@(mine?"YOUR TURN":me.HasPassed?"YOU HAVE PASSED":"ON TURN")</p><h2>@(mine?"Your move":active?.Name??"All passed")</h2>
                @if(active is not null){<PrototypeTurnClock EventTime="s.LastActivityUtc" />}
                @if(s.SecondaryCardId is int sc){
                    <div class="workflow"><h3>@Store.Card(sc)?.Name</h3><p>@(secondary?.Id==me.Id?"Will you follow?":$"Waiting for {secondary?.Name}")</p>
                    @if(secondary?.Id==me.Id){@if(following){<button class="table-primary" disabled="@busy" @onclick="SecondaryDone">Secondary complete ✓</button>}else{<button class="table-primary" disabled="@busy" @onclick="()=>following=true">Follow</button><button disabled="@busy" @onclick="SecondaryDone">Skip</button>}}</div>
                }
                else if(s.ActiveStrategyCardId is int primary){<div class="workflow"><h3>@Store.Card(primary)?.Name</h3><p>@(mine?"Resolve the primary at the table.":$"{active?.Name} resolves the primary.")</p>@if(mine){@if(s.SpeakerPending){<PrototypeSpeakerPicker Politics="true" />}<button class="table-primary" disabled="@(busy||s.SpeakerPending)" @onclick="OpenSecondary">Primary complete →</button>}</div>}
                else if(mine){
                    <div class="turn-actions"><button class="table-primary" disabled="@busy" @onclick="Advance">End turn →</button><button disabled="@(busy||me.StrategyCards.Any(c=>!c.IsExhausted))" @onclick="Pass">Pass</button><button disabled="@(busy||me.StrategyCards.All(c=>c.IsExhausted))" @onclick="()=>showCards=!showCards">Play SC ▾</button></div>
                    @if(showCards){<div class="own-cards">@foreach(var c in me.StrategyCards.Where(c=>!c.IsExhausted)){<button disabled="@busy" @onclick="()=>Play(c.StrategyCardId)">@c.StrategyCardId · @Store.Card(c.StrategyCardId)?.Name</button>}</div>}
                }
                else{<p class="waiting-message">@(me.HasPassed?"You can still follow secondaries.":"Plan your next move.")</p>}
                </section>
                @if(Store.IsHost&&s.Players.All(p=>p.HasPassed)){<button class="table-primary" disabled="@busy" @onclick="StatusPhase">Start status phase →</button>}
            }
            <section class="initiative-list" aria-label="Initiative order"><div class="table-section-title"><span>INITIATIVE ORDER</span></div>@foreach(var p in order){<div class="init-player @(p.Id==s.ActivePlayerId?"current":"") @(p.HasPassed?"passed":"")"><b>@(p.Initiative?.ToString()??"—")</b><strong>@p.Name</strong><span>@(p.HasPassed?"PASS":p.Id==s.ActivePlayerId?"◀":"")</span></div>}</section>
            </div><aside><PrototypeStrategyBoard /></aside></div>
        }
        else if (s.Phase == GamePhase.Status)
        {
            <section class="table-panel"><p class="table-kicker">WRAP UP THE ROUND</p>
            @if (s.StatusStage == StatusStage.Scoring)
            { <h2>Score objectives.</h2><p>@(Store.PlayerById(s.StatusScorerId)?.Name ?? "Everyone is done") · in initiative order</p><p>Check and score your public and secret objectives at the table.</p>
            @if (s.StatusScorerId == me.Id) { <button class="table-primary" disabled="@busy" @onclick="ScoreDone">Scoring complete</button> }
            @if (Store.IsHost && s.StatusScorerId is null) { <button class="table-primary" disabled="@busy" @onclick="RevealStage">Reveal next objective →</button> } }
            else if (s.StatusStage == StatusStage.RevealObjective)
            { <h2>Reveal a new objective.</h2><p>Reveal the next public objective at the table.</p>@if (Store.IsHost) { <button class="table-primary" disabled="@busy" @onclick="ChecklistStage">Objective revealed →</button> } }
            else
            { <h2>Ready for round @(s.CurrentRound + 1)?</h2>@foreach (var step in Steps) { var done = s.StatusStepsDone.HasFlag(step.Item1); <button class="table-check" disabled="@(busy || !Store.IsHost)" @onclick="() => Check(step.Item1,!done)"><span>@(done ? "✓" : "○")</span>@step.Item2</button> }
              @if (Store.IsHost) { <label class="table-agenda"><input type="checkbox" @bind="agendaDone" /> Resolve the agenda phase at the table if needed, then confirm. If no agenda is needed, confirm to continue.</label><button class="table-primary" disabled="@(busy || !agendaDone || Steps.Any(x => !s.StatusStepsDone.HasFlag(x.Item1)))" @onclick="NextRound">Next round →</button> } }
            </section>
        }

        <footer class="table-foot">@(Store.IsHost?"Host":"Player") · Live session · No turn time limit</footer><PrototypeTurnAttention Active="@(mine&&s.Phase==GamePhase.Action)" />
    }
</main>

@code {
    [Parameter] public string? Code { get; set; }
    [SupplyParameterFromQuery(Name="device")] public int Device { get; set; }
    [SupplyParameterFromQuery(Name="join")] public string? Invite { get; set; }
    [SupplyParameterFromQuery(Name="choose")] public bool ChooseIdentity { get; set; }
    string? error; bool showCards;
    bool HasCode => !string.IsNullOrWhiteSpace(Code??Invite);
    string InviteUrl=>Nav.BaseUri.TrimEnd('/')+"/table?join="+Uri.EscapeDataString(Store.Session!.JoinCode);
    bool loaded, busy, following, agendaDone;
    readonly (StatusStep,string)[] Steps = [(StatusStep.DrawActionCards,"Draw action cards"),(StatusStep.CommandTokens,"Remove, gain & redistribute command tokens"),(StatusStep.ReadyCards,"Ready cards"),(StatusStep.RepairUnits,"Repair units"),(StatusStep.ReturnStrategyCards,"Return strategy cards"),(StatusStep.EndOfStatusAbilities,"Resolve end-of-status abilities")];
    protected override async Task OnParametersSetAsync() { loaded=false;error=null;try { await Store.InitAsync(); var code=(Code??Invite)?.Trim().ToUpperInvariant(); if(!string.IsNullOrEmpty(code)&&!await Store.ConnectAsync(code))error="Session not found."; Loc.SetLanguage(Language.En); } catch { error="Cannot connect. Please reload."; } finally {loaded=true;} }
    void Go(string code) => Nav.NavigateTo($"/table/{code}" + (Device is >=1 and <=3 ? $"?device={Device}" : ""));
    void Back() => Nav.NavigateTo("/table?join=" + Uri.EscapeDataString(Code ?? "") + (Device is >=1 and <=3 ? $"&device={Device}" : ""));
    async Task Run(Func<Task> action) { if (busy || !Store.Connected && Store.Session is not null) return; busy=true; error=null; try { await action(); } catch { error="The action was not confirmed. Check the table state and try again."; } finally { busy=false; } }
    Task Mutate(Func<Task<SessionStateDto?>> action) => Run(async () => { var result=await action(); if (result is null) { error="Action unavailable. The table has been updated."; await Store.RefreshAsync(); } else await Store.Mutate(Task.FromResult<SessionStateDto?>(result)); });
    Task Claim(Guid player)=>Run(async()=>{var s=await Store.JoinAsync(Store.Session!.JoinCode,new("",null,null,null,player));if(s is null){error="This seat is already connected. Choose another player.";await Store.RefreshAsync();}else Go(s.JoinCode);});
    Guid Id => Store.Session!.Id;
    Task Pick(Guid player,int card) => Mutate(()=>Store.Api.AssignStrategyCardAsync(Id,player,card));
    Task ActionPhase() => Mutate(()=>Store.Api.StartActionPhaseAsync(Id));
    Task Advance() => Mutate(()=>Store.Api.AdvanceTurnAsync(Id));
    Task Pass() => Mutate(()=>Store.Api.SetPassedAsync(Id,Store.Me!.Id,true));
    Task Play(int card) { showCards=false; return Mutate(()=>Store.Api.SetActiveStrategyAsync(Id,card)); }
    Task OpenSecondary() => Mutate(()=>Store.Api.SetSecondaryPlayersAsync(Id,Store.Session!.Players.Where(p=>p.Id!=Store.Session.ActivePlayerId).Select(p=>p.Id).ToList()));
    Task SecondaryDone() => Run(async()=> { await Store.Mutate(Store.Api.SetSecondaryDoneAsync(Id,Store.Me!.Id)); following=false; });
    Task StatusPhase() => Mutate(()=>Store.Api.EndActionPhaseAsync(Id));
    Task ScoreDone() => Mutate(()=>Store.Api.SetStatusDoneAsync(Id,Store.Me!.Id,true));
    Task RevealStage() => Mutate(()=>Store.Api.SetStatusStageAsync(Id,StatusStage.RevealObjective));
    Task ChecklistStage() => Mutate(()=>Store.Api.SetStatusStageAsync(Id,StatusStage.Checklist));
    Task Check(StatusStep step,bool done) => Mutate(()=>Store.Api.SetStatusStepAsync(Id,step,done));
    Task NextRound() => Mutate(()=>Store.Api.NextRoundAsync(Id));
    static PlayerDto? SecondaryPlayer(SessionStateDto s) { var seats=s.Players.OrderBy(p=>p.SeatOrder).ToList(); var start=seats.FindIndex(p=>p.Id==s.SecondaryOwnerId); return Enumerable.Range(1,seats.Count).Select(i=>seats[(Math.Max(start,0)+i)%seats.Count]).FirstOrDefault(p=>p.SecondaryPending); }
    static PlayerDto? NextPlayer(SessionStateDto s) { var players=s.Players.Where(p=>!p.HasPassed).OrderBy(p=>p.Initiative??99).ThenBy(p=>p.SeatOrder).ToList(); if(players.Count==0)return null; var index=players.FindIndex(p=>p.Id==s.ActivePlayerId); return players[(index+1)%players.Count]; }
    static string Phase(GamePhase phase) => phase switch { GamePhase.Setup=>"Setup",GamePhase.Strategy=>"Strategy phase",GamePhase.Action=>"Action phase",GamePhase.Status=>"Status phase",_=>"Agenda" };
}
