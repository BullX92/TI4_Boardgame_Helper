@inherits Ti4ComponentBase
@if(Store.Session is {} s){
<section class="sc-overview" aria-label="Strategy card overview">
    <div class="board-heading"><span>STRATEGY CARDS</span>@if(s.Players.FirstOrDefault(p=>p.FactionId=="naalu") is {} naalu){<span class="naalu-token" title="Naalu initiative 0 · @naalu.Name">NAALU 0 · @naalu.Name</span>}</div>
    @for(var id=1;id<=8;id++){
        var card=id;var owner=s.Players.FirstOrDefault(p=>p.StrategyCards.Any(c=>c.StrategyCardId==card));var used=owner?.StrategyCards.First(c=>c.StrategyCardId==card).IsExhausted==true;
        <div class="sc-strip @(used?"played":"") @(owner is null?"available":"")" style="--card:@Colors[id-1]" data-card="@id" data-played="@used.ToString().ToLowerInvariant()">
            <div class="sc-face"><div class="sc-label"><strong>@Labels[id-1]</strong><small class="card-owner">@if(owner is not null){<span class="owner-art" style="border-color:@owner.ColorHex"><PrototypeFactionArt FactionId="@owner.FactionId" Name="@owner.Name" /></span>}<span class="owner-name" title="@(owner?.Name??"Not picked")">@(owner?.Name??"Not picked")</span></small></div><div class="sc-number"><b>@id</b><span>@(used?"✓ PLAYED":owner is not null?"PICKED":"—")</span></div></div>
        </div>
    }
</section>}
@code{
    static readonly string[] Labels=["Leadership","Diplomacy","Politics","Construction","Trade","Warfare","Technology","Imperial"];
    static readonly string[] Colors=["#ef5555","#f49b42","#ead759","#86c853","#34c4b3","#409ada","#a082da","#d469c2"];
}
