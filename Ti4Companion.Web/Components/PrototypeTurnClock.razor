@implements IDisposable
@inject SessionStore Store
<div class="turn-clock" role="timer" aria-label="Turn time"><span>TURN TIME</span><strong>@Elapsed</strong></div>
@code {
    [Parameter] public DateTimeOffset EventTime { get; set; }
    DateTimeOffset? start;
    DateTimeOffset last;
    System.Threading.Timer? timer;
    bool disposed;
    string Elapsed { get { var t=DateTimeOffset.UtcNow-(start??DateTimeOffset.UtcNow); return $"{Math.Max(0,(int)t.TotalMinutes):00}:{Math.Max(0,t.Seconds):00}"; } }
    protected override void OnInitialized() => timer = new(_=> { if(!disposed) _ = InvokeAsync(StateHasChanged); },null,1000,1000);
    protected override async Task OnParametersSetAsync() {
        if (last==EventTime || Store.Session is not {} s) return;
        last=EventTime;
        try { var log=await Store.Api.GetLogAsync(s.JoinCode); start=log.LastOrDefault(e=>e.Kind==SessionLogKind.TurnChange && e.TargetPlayerId==s.ActivePlayerId)?.TimestampUtc; }
        catch { start=null; }
    }
    public void Dispose() { disposed=true; timer?.Dispose(); }
}
