@implements IAsyncDisposable
@inject IJSRuntime JS

<button @ref="trigger" class="tools-toggle" type="button" aria-label="Open table tools" aria-expanded="@expanded.ToString().ToLowerInvariant()"
        aria-controls="table-tools-dialog" @onclick="Open">
    <span aria-hidden="true">☰</span><span class="tools-toggle-text">TOOLS</span><span aria-hidden="true">›</span>
</button>
<dialog @ref="dialog" id="table-tools-dialog" class="table-tools-dialog" aria-label="Table tools">
    @if (expanded)
    {
        <button class="tools-scrim" type="button" aria-label="Close table tools" tabindex="-1" @onclick="Close"></button>
        <div class="tools-dock @(selected is null ? "" : "has-panel")">
            <nav class="tools-nav" aria-label="Table options">
                <div class="tools-nav-heading"><span>TOOLS</span><button class="tools-close" type="button" aria-label="Close table tools" autofocus @onclick="Close">×</button></div>
                <button class="tools-option @(selected == "times" ? "selected" : "")" type="button" aria-pressed="@((selected == "times").ToString().ToLowerInvariant())" @onclick="ShowTimes"><span aria-hidden="true">⏱</span><span>Player times</span></button>
                @if (IsHost)
                {
                    <button class="tools-option @(selected == "admin" ? "selected" : "")" type="button" aria-pressed="@((selected == "admin").ToString().ToLowerInvariant())" @onclick="ShowAdmin"><span aria-hidden="true">⚙</span><span>Admin</span></button>
                }
            </nav>
            @if (selected is not null)
            {
                <section class="tools-panel" aria-label="@(selected == "times" ? "Player times panel" : "Admin panel")">
                    <button class="tools-panel-close" type="button" aria-label="Close panel" @onclick="ClosePanel">×</button>
                    @if (selected == "times") { <PrototypeTimeSidebar Session="Session" /> }
                    else if (selected == "admin" && IsHost) { <PrototypeAdminPanel Session="Session" /> }
                </section>
            }
        </div>
    }
</dialog>

@code {
    [Parameter, EditorRequired] public SessionStateDto Session { get; set; } = default!;
    [Parameter] public bool IsHost { get; set; }
    ElementReference dialog;
    ElementReference trigger;
    IJSObjectReference? module;
    DotNetObjectReference<PrototypeToolsRail>? callback;
    bool expanded, pendingOpen, disposed;
    string? selected;

    void Open() { expanded = true; pendingOpen = true; }
    void Select(string option) => selected = option == "admin" && !IsHost ? null : option;
    void ShowTimes() => Select("times");
    void ShowAdmin() => Select("admin");
    async Task ClosePanel()
    {
        selected = null;
        if (module is not null) await module.InvokeVoidAsync("focusOption", dialog);
    }
    protected override void OnParametersSet() { if (!IsHost && selected == "admin") selected = null; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!pendingOpen || disposed) return;
        pendingOpen = false;
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/prototype-tools-rail.js");
        if (disposed) return;
        callback ??= DotNetObjectReference.Create(this);
        await module.InvokeVoidAsync("open", dialog, callback, trigger);
    }
    async Task Close()
    {
        expanded = pendingOpen = false;
        selected = null;
        if (module is not null) await module.InvokeVoidAsync("close", dialog);
    }
    [JSInvokable] public Task DialogClosed() => InvokeAsync(() => { expanded = pendingOpen = false; selected = null; StateHasChanged(); });
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("disconnect", dialog); await module.DisposeAsync(); }
            catch (JSException) { }
        }
        callback?.Dispose();
    }
}
